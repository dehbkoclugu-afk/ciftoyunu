{
  "name": "project-duo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "content:validate": "node --import tsx scripts/content-tool.ts validate",
    "content:duplicates": "node --import tsx scripts/content-tool.ts duplicates",
    "content:report": "node --import tsx scripts/content-tool.ts report",
    "content:build": "node --import tsx scripts/content-tool.ts build",
    "content:check": "node --import tsx scripts/content-tool.ts check",
    "content:diff": "node --import tsx scripts/content-tool.ts check",
    "release:env:check": "node --import tsx scripts/validate-release-env.ts",
    "expo:doctor": "expo-doctor",
    "export:web": "expo export --platform web",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test -- --runInBand && npm run content:validate && npm run content:duplicates && npm run content:check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "7.11.0",
    "expo": "~57.0.13",
    "expo-application": "57.0.2",
    "expo-constants": "~57.0.11",
    "expo-crypto": "57.0.1",
    "expo-device": "57.0.1",
    "expo-file-system": "57.0.4",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "posthog-react-native": "4.63.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-purchases": "10.7.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.0",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
